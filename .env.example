PORT=3000
DB_HOST=your-rds-endpoint.ap-south-1.rds.amazonaws.com
DB_USER=admin
DB_PASS=change-me
DB_NAME=vaultdb
# 64 hex chars (32 bytes). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AES_KEY=
# Long random string. Generate the same way.
JWT_SECRET=
# The account registered with this email gets admin capabilities
ADMIN_EMAIL=admin@example.com
